generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model Business {
  id       String @id
  name     String
  sequence Int @default(0)
  products Product[]
  shifts   Shift[]
  sales    Sale[]
  mercadoPago MercadoPagoConnection?
  paymentOrders PaymentOrder[]
}
model Product {
  id          String @id @default(cuid())
  business    String
  shop        Business @relation(fields: [business], references: [id])
  name        String
  description String
  price       Int
  unit        String @default("unit")
  category    String
  emoji       String
  @@index([business])
}
model Shift {
  id         String @id @default(cuid())
  business   String
  shop       Business @relation(fields: [business], references: [id])
  fund       Int
  opened     DateTime @default(now())
  closed     DateTime?
  expected   Int?
  counted    Int?
  difference Int?
  reason     String @default("")
  sales      Sale[]
  @@index([business, closed])
}
model Sale {
  id        String @id @default(cuid())
  business  String
  shop      Business @relation(fields: [business], references: [id])
  number    String
  shift     String
  session   Shift @relation(fields: [shift], references: [id])
  items     Json
  total     Int
  received  Int
  change    Int
  method    String
  reference String @default("")
  mode      String
  note      String @default("")
  date      DateTime @default(now())
  @@unique([business, number])
  @@index([business, date])
}

model MercadoPagoConnection {
  business String @id
  shop Business @relation(fields: [business], references: [id])
  sellerId String
  credentials String
  expiresAt DateTime
  connectedAt DateTime @default(now())
}
model PaymentOrder {
  id String @id
  business String
  shop Business @relation(fields: [business], references: [id])
  sellerId String
  shift String
  items Json
  total Int
  mode String
  note String
  preferenceId String? @unique
  checkoutUrl String?
  status String @default("pending")
  paymentId String? @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([business, status])
}
model MercadoPagoOAuth {
  id String @id
  business String
  verifier String
  expiresAt DateTime
}
